msgid "%d MLO interface(s) override the auto-generated MLD ifname."
msgstr "%d 个 MLO 接口覆盖了自动生成的 MLD ifname。"

msgid "%d MLO interface(s) still have fewer than two radios selected."
msgstr "%d 个 MLO 接口当前选择的 radio 少于 2 个。"

msgid "802.11w Management Frame Protection"
msgstr "802.11w 管理帧保护"

msgid "AP MLO is usually paired with WPA3-SAE or OWE"
msgstr "AP MLO 通常搭配 WPA3-SAE 或 OWE 使用"

msgid "Access Point"
msgstr "接入点 (AP)"

msgid "Client"
msgstr "客户端"

msgid "Ad-Hoc"
msgstr "点对点 Ad-Hoc"

msgid "Mesh"
msgstr "Mesh 组网"

msgid "Active"
msgstr "活动"

msgid "Active MLD ifnames"
msgstr "活动的 MLD ifname"

msgid "Add MLO-ready interface"
msgstr "添加支持 MLO 的接口"

msgid "Advanced"
msgstr "高级"

msgid ""
"At least two configured radios are required before an MLO interface can be "
"created."
msgstr "至少需要 2 个已配置 radio 才能创建 MLO 接口。"

msgid "Attached network(s)"
msgstr "绑定的网络"

msgid "BSSID"
msgstr "BSSID"

msgid "Configured radios"
msgstr "已配置的 radio"

msgid "Custom ifname overrides the default ap-mldX / sta-mldX naming"
msgstr "自定义 ifname 会覆盖默认的 ap-mldX / sta-mldX 命名"

msgid "Disabled"
msgstr "已禁用"

msgid "Disassociate on low ACK"
msgstr "低 ACK 时断开关联"

msgid "Edit wireless interface"
msgstr "编辑无线接口"

msgid "Enable MLO"
msgstr "启用 MLO"

msgid "Enable OCV"
msgstr "启用 OCV"

msgid "Enable U-APSD"
msgstr "启用 U-APSD"

msgid "Enable WDS / 4-address mode"
msgstr "启用 WDS / 4 地址模式"

msgid "Enabled"
msgstr "已启用"

msgid "Encryption"
msgstr "加密"

msgid ""
"For AP MLO, WPA3-SAE with Management Frame Protection set to Required is the "
"most compatible starting point in this tree."
msgstr "对于 AP MLO，本代码树里最兼容的起始配置通常是 WPA3-SAE，并将管理帧保护设为“必需”。"

msgid "General"
msgstr "常规"

msgid "Grant access to LuCI app WiFi Manager"
msgstr "授予访问 LuCI WiFi Manager 应用的权限"

msgid "Hide SSID"
msgstr "隐藏 SSID"

msgid "Interface name"
msgstr "接口名"

msgid ""
"Logical network names from <code>/etc/config/network</code>, for example "
"<code>lan</code>."
msgstr "来自 <code>/etc/config/network</code> 的逻辑网络名，例如 <code>lan</code>。"

msgid "MAC address"
msgstr "MAC 地址"

msgid "MLD runtime"
msgstr "MLD 运行态"

msgid "MLO"
msgstr "MLO"

msgid ""
"MLO is configured, but no active runtime MLD interface is currently reported."
msgstr "已配置 MLO，但当前没有检测到活动的运行时 MLD 接口。"

msgid "MLO requires at least two radio devices"
msgstr "MLO 至少需要 2 个 radio 设备"

msgid "MLO-enabled"
msgstr "已启用 MLO"

msgid "Mode"
msgstr "模式"

msgid "Needs at least two radios"
msgstr "至少需要 2 个 radio"

msgid "Networks"
msgstr "网络"

msgid "No MLO-enabled wireless interface is configured yet."
msgstr "当前还没有配置启用 MLO 的无线接口。"

msgid "No active interface was reported yet"
msgstr "当前还没有上报活动接口"

msgid "No encryption"
msgstr "不加密"

msgid "No radio is configured. MLO needs at least two radios."
msgstr "当前没有配置任何 radio。MLO 至少需要 2 个 radio。"

msgid "No runtime state"
msgstr "无运行状态"

msgid "No wireless interfaces are configured yet."
msgstr "当前还没有配置任何无线接口。"

msgid "OWE"
msgstr "OWE"

msgid "Only one radio is configured. MLO needs at least two radios."
msgstr "当前只配置了 1 个 radio。MLO 至少需要 2 个 radio。"

msgid "Optional"
msgstr "可选"

msgid "Optional override for the generated interface MAC address."
msgstr "可选，用于覆盖自动生成的接口 MAC 地址。"

msgid ""
"Optional override. Leave empty to use auto-generated names such as <code>ap-"
"mld0</code> or <code>sta-mld0</code>."
msgstr "可选覆盖项。留空时会使用自动生成的名称，例如 <code>ap-mld0</code> 或 <code>sta-mld0</code>。"

msgid "Passphrase"
msgstr "密码"

msgid "Passphrase is required for the selected encryption"
msgstr "所选加密方式必须填写密码"

msgid "Present"
msgstr "已存在"

msgid "Profile"
msgstr "配置概览"

msgid "Quick Add AP MLO"
msgstr "快速添加 AP MLO"

msgid "Quick Add STA MLO"
msgstr "快速添加 STA MLO"

msgid "Radio devices"
msgstr "Radio 设备"

msgid "Radios"
msgstr "Radio 列表"

msgid "Refresh Runtime Status"
msgstr "刷新运行状态"

msgid "Required"
msgstr "必需"

msgid "Runtime"
msgstr "运行状态"

msgid ""
"Runtime detection looks healthy. Auto-generated MLD names appear as <code>ap-"
"mldX</code> or <code>sta-mldX</code>."
msgstr "运行状态检测正常。自动生成的 MLD 名称通常显示为 <code>ap-mldX</code> 或 <code>sta-mldX</code>。"

msgid "Runtime radios"
msgstr "运行时 radios"

msgid "SSID"
msgstr "SSID"

msgid "Save & Apply, then verify driver support if this persists"
msgstr "请先“保存并应用”；如果仍然如此，再检查驱动是否支持"

msgid "Section is disabled in UCI"
msgstr "该 section 在 UCI 中已禁用"

msgid "Security"
msgstr "安全"

msgid "Select at least one radio device"
msgstr "至少选择 1 个 radio 设备"

msgid "Select one radio for normal Wi-Fi, or two or more radios for MLO."
msgstr "普通 Wi-Fi 请选择 1 个 radio；MLO 请至少选择 2 个 radio。"

msgid "Single-link"
msgstr "单链路"

msgid "Stations"
msgstr "终端数"

msgid "WPA/WPA2 mixed PSK"
msgstr "WPA/WPA2 混合 PSK"

msgid "WPA2-PSK"
msgstr "WPA2-PSK"

msgid "WPA2/WPA3 mixed"
msgstr "WPA2/WPA3 混合"

msgid "WPA3-SAE"
msgstr "WPA3-SAE"

msgid ""
"When enabled, this <code>wifi-iface</code> spans multiple radios through a "
"multi-value <code>device</code> list."
msgstr "启用后，此 <code>wifi-iface</code> 会通过多值 <code>device</code> 列表跨多个 radio 工作。"

msgid "WiFi Manager"
msgstr "WiFi管理"

msgid "WiFi Manager Overview"
msgstr "WiFi Manager 概览"

msgid "Wireless Interfaces"
msgstr "无线接口"

msgid "Wireless interfaces"
msgstr "无线接口"

msgid "channel %s"
msgstr "信道 %s"

msgid "ifname"
msgstr "ifname"

msgid "none"
msgstr "无"

msgid "unknown"
msgstr "未知"

msgid "unset"
msgstr "未设置"
